<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>AI Academy - <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Accueil' %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header>
    <div class="logo">
      <img src="/images/logo.png" alt="Logo AI Academy">
      <h1>AI Academy</h1>
    </div>
    <nav>
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/courses">Cours</a></li>
        <li><a href="/subscribers">Abonnés</a></li>
        <% if (loggedIn) { %>
          <li><a href="/users">Utilisateurs</a></li>
          <li><a href="/users/<%= currentUser._id %>">Mon Profil</a></li>
          <li><a href="/logout">Se déconnecter</a></li>
        <% } else { %>
          <li><a href="/login">Se connecter</a></li>
          <li><a href="/signup">S'inscrire</a></li>
        <% } %>
      </ul>
    </nav>
  </header>

  <!-- Messages flash -->
  <div class="flashes">
    <% if (flashMessages.success) { %>
      <div class="flash success"><%= flashMessages.success %></div>
    <% } %>
    <% if (flashMessages.error) { %>
      <div class="flash error"><%= flashMessages.error %></div>
    <% } %>
  </div>

  <main>
    <%- body %>
  </main>

  <footer>
    <p>&copy; <%= new Date().getFullYear() %> AI Academy</p>
  </footer>
</body>
</html>